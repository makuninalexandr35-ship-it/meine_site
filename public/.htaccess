Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # HTML must be revalidated on every visit, so browsers do not show an old
  # page after publication. Images, video, CSS and JavaScript retain normal caching.
  <FilesMatch "\.(?:html?|xhtml)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://aleksandrmakunin.ru%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.aleksandrmakunin\.ru$ [NC]
RewriteRule ^ https://aleksandrmakunin.ru%{REQUEST_URI} [R=301,L]

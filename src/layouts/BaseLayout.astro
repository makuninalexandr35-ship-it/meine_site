---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isConfiguredContact, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  crumbName?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  yandexNoindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  webPageSchema?: Record<string, unknown>;
  additionalSchema?: Record<string, unknown>[];
}
const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  crumbName,
  canonicalPath = '/',
  image = '/Logotip.webp',
  imageAlt = 'Александр Макунин — разработка сайтов и AI-решений',
  ogType = 'website',
  noindex = false,
  yandexNoindex = false,
  breadcrumbs,
  webPageSchema = {},
  additionalSchema = [],
} = Astro.props;
const canonical = new URL(canonicalPath, site.siteUrl).toString();
const imageUrl = new URL(image, site.siteUrl).toString();
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Structured data (schema.org) built only from facts the site already states: its name and address, the page title, description and address, the owner's name and Telegram.
const homeUrl = new URL('/', site.siteUrl).toString();
const crumbs = breadcrumbs ?? (canonicalPath === '/' ? [] : [{ name: 'Главная', url: homeUrl }, { name: crumbName ?? title, url: canonical }]);
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': `${homeUrl}#website`, url: homeUrl, name: site.siteName, inLanguage: 'ru-RU', ...(canonicalPath === '/' ? { publisher: { '@id': `${homeUrl}#person` } } : {}) },
  {
    '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'ru-RU',
    isPartOf: { '@id': `${homeUrl}#website` },
    ...(crumbs.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    ...webPageSchema,
  },
];
if (crumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
    itemListElement: crumbs.map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, name: crumb.name, item: crumb.url })),
  });
}
if (canonicalPath === '/') {
  graph.push({ '@type': 'Person', '@id': `${homeUrl}#person`, name: site.ownerName, url: homeUrl, ...(isConfiguredContact(site.telegramUrl) ? { sameAs: [site.telegramUrl] } : {}) });
}
graph.push(...additionalSchema);
const jsonLd = noindex ? null : JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta name="yandex-verification" content="4716bbfa1f13cf9a" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    {yandexNoindex && <meta name="yandex" content="noindex" />}
    <meta name="author" content={site.ownerName} />
    <meta name="theme-color" content="#07101c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=113432740', 'ym');

      ym(113432740, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/113432740" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <Header />
    <main><slot /></main>
    <Footer />
    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 48);
      updateHeader(); window.addEventListener('scroll', updateHeader, { passive: true });
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .14 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

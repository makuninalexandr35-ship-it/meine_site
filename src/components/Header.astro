---
import Logo from '../assets/Logotip.webp';
import { site } from '../data/site';
const isHome = Astro.url.pathname === '/';
const logoHref = isHome ? '#top' : '/';
const navigation = site.navigation.map((item) => ({ ...item, href: isHome ? `#${item.id}` : item.href }));
---
<header class="header" data-header>
  <div class="header__inner container">
    <a class="logo" href={logoHref} aria-label="На главную"><img src={Logo.src} width={Logo.width} height={Logo.height} alt="" /></a>
    <nav class="desktop-nav" aria-label="Основная навигация">
      {navigation.map((item) => <a href={item.href} data-nav={item.id}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href={isHome ? '#contact' : '/#contact'}>Обсудить проект <span aria-hidden="true">→</span></a>
    <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu__top container"><button class="close" type="button" aria-label="Закрыть меню">×</button></div>
    <nav class="mobile-menu__nav container" aria-label="Мобильная навигация">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="mobile-menu__cta" href={isHome ? '#contact' : '/#contact'}>Обсудить проект <span aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('.mobile-menu');
  const close = document.querySelector<HTMLButtonElement>('.close');
  const setOpen = (open: boolean) => { if (!menu || !toggle) return; menu.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); document.body.classList.toggle('menu-open', open); };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  close?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
</script>
<style>
  .header { position:fixed; inset:0 0 auto; z-index:20; padding-top:14px; animation:header-in .5s both; background:#0d192a; border-bottom:1px solid rgba(40,199,255,.22); transition:background var(--transition),backdrop-filter var(--transition),border-color var(--transition); }
  .header.is-scrolled { background:#0d192a; backdrop-filter:blur(18px); border-bottom-color:rgba(40,199,255,.42); }
  .header__inner { height:calc(var(--header-height) - 14px); display:flex; align-items:center; justify-content:space-between; gap:28px; }
  .logo { display:flex; width:auto; max-width:340px; border-radius:8px; }
  .logo img { width:auto; height:102px; filter:drop-shadow(0 3px 12px rgba(40,199,255,.18)); animation:header-logo-glow 5s ease-in-out infinite; }
  .desktop-nav { display:flex; align-items:center; gap:clamp(18px,2.2vw,38px); margin-left:auto; }
  .desktop-nav a { position:relative; color:var(--text-secondary); font-size:14px; font-weight:700; transition:color var(--transition); }
  .desktop-nav a::after { content:''; position:absolute; right:0; bottom:-9px; left:0; height:1px; opacity:0; background:linear-gradient(90deg,var(--red),var(--blue-bright)); transition:opacity var(--transition); }
  .desktop-nav a:hover,.desktop-nav a:focus-visible { color:var(--text-primary); }.desktop-nav a:hover::after { opacity:1; }
  .header-cta { display:flex; align-items:center; gap:9px; min-height:44px; padding:0 16px; border:1px solid rgba(46,107,255,.45); border-radius:12px; color:var(--text-primary); font-size:14px; font-weight:700; transition:background var(--transition),border-color var(--transition); animation:cta-breathe 4s ease-in-out infinite; }.header-cta:hover { background:rgba(46,107,255,.14); border-color:var(--blue-bright); }
  .menu-toggle,.close { display:none; color:var(--text-primary); background:none; border:0; cursor:pointer; }.menu-toggle { width:54px; height:54px; padding:12px; border:1px solid rgba(40,199,255,.86); border-radius:14px; background:#15263e; box-shadow:0 0 22px rgba(46,107,255,.32),inset 0 0 16px rgba(255,51,77,.1); animation:cta-breathe 3.6s ease-in-out infinite; }.menu-toggle span { display:block; height:3px; margin:7px 0; border-radius:9px; background:linear-gradient(90deg,#ffffff,var(--blue-bright)); box-shadow:0 0 9px rgba(40,199,255,.6); }
  .mobile-menu { position:fixed; inset:0; z-index:100; min-height:100dvh; overflow-y:auto; isolation:isolate; background:#07101c; }.mobile-menu[hidden] { display:none !important; }.mobile-menu::before { content:''; position:absolute; z-index:-1; inset:0; background:radial-gradient(circle at 80% 0,rgba(46,107,255,.14),transparent 35%),radial-gradient(circle at 0 100%,rgba(255,51,77,.1),transparent 38%); }.mobile-menu__top { display:flex; justify-content:flex-end; height:88px; align-items:center; }.close { display:block; width:48px; height:48px; border:1px solid rgba(255,255,255,.16); border-radius:12px; background:#15263e; box-shadow:0 0 14px rgba(46,107,255,.2); font-size:32px; }.mobile-menu__nav { display:grid; gap:6px; padding-top:34px; text-align:center; }.mobile-menu__nav a:not(.mobile-menu__cta) { padding:6px 0; font-family:'Space Grotesk',sans-serif; font-size:clamp(23px,6.5vw,30px); font-weight:600; letter-spacing:-.04em; }.mobile-menu__cta { display:inline-flex; justify-self:center; align-items:center; gap:12px; min-height:44px; margin-top:17px; padding:0 16px; border-radius:12px; background:linear-gradient(100deg,var(--red),#c03870,var(--blue)); box-shadow:0 9px 21px rgba(46,107,255,.2); font-size:15px; font-weight:800; animation:cta-breathe 4s ease-in-out infinite; }
  @keyframes header-in { from { opacity:0; transform:translateY(-12px); } to { opacity:1; transform:none; } } @keyframes cta-breathe { 50% { box-shadow:0 0 22px rgba(40,199,255,.28),0 0 14px rgba(255,51,77,.15); } } @keyframes header-logo-glow { 50% { filter:drop-shadow(0 3px 18px rgba(40,199,255,.56)); } }
  @media(max-width:767px) { .desktop-nav,.header-cta { display:none; }.menu-toggle { display:block; }.logo img { height:76px; }.header { padding-top:8px; }.header__inner { height:calc(var(--header-height) - 8px); } }
</style>

---
import Button from './Button.astro';
---
<section class="hero" id="top">
  <div class="hero__grid container">
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow">САЙТЫ • ВЕБ-СЕРВИСЫ • AI-РЕШЕНИЯ</p>
      <h1>Разрабатываю сайты,<br />веб-сервисы и <span class="gradient-text">AI-решения</span><br />под задачи бизнеса</h1>
      <p class="hero__copy">От структуры и интерфейса до разработки и запуска — создаю цельный цифровой продукт, а не набор отдельных экранов.</p>
      <div class="hero__actions"><Button href="#works" size="lg">Смотреть проекты</Button><Button href="#contact" variant="secondary" size="lg">Обсудить задачу</Button></div>
      <div class="hero__markers" aria-label="Этапы создания"><span>Структура</span><span>Дизайн</span><span>Разработка</span><span>Запуск</span></div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="orbit orbit--one"></div><div class="orbit orbit--two"></div>
      <div class="product-frame"><div class="product-frame__bar"><i></i><i></i><i></i></div><div class="product-frame__wave"></div><div class="product-frame__line"></div><div class="product-frame__panel"></div></div>
    </div>
  </div>
</section>
<style>
  .hero { position:relative; display:flex; align-items:center; min-height:max(100svh,760px); overflow:hidden; isolation:isolate; }.hero::before,.hero::after { content:''; position:absolute; z-index:-1; border-radius:50%; filter:blur(12px); pointer-events:none; }.hero::before { width:52vw; height:52vw; right:-24vw; top:-25vw; background:radial-gradient(circle,rgba(255,51,77,.22),transparent 65%); }.hero::after { width:48vw; height:48vw; right:-17vw; bottom:-31vw; background:radial-gradient(circle,rgba(46,107,255,.25),transparent 65%); }.hero__grid { display:grid; grid-template-columns:1.06fr .94fr; align-items:center; gap:50px; padding-top:var(--header-height); }.hero h1 { max-width:850px; margin-bottom:28px; font-size:clamp(56px,6.2vw,96px); line-height:.99; letter-spacing:-.055em; }.hero__eyebrow { animation:fade-up .7s .18s both; }.hero h1 { animation:fade-up .75s .29s both; }.hero__copy { max-width:630px; color:var(--text-secondary); font-size:clamp(18px,1.45vw,20px); animation:fade-up .75s .43s both; }.hero__actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; animation:fade-up .75s .56s both; }.hero__markers { display:flex; flex-wrap:wrap; gap:10px 25px; margin-top:42px; color:var(--text-muted); font-size:13px; font-weight:700; }.hero__markers span::before { content:'•'; margin-right:9px; color:var(--blue-bright); }.hero-visual { position:relative; min-height:550px; animation:visual-in .9s .4s both; }.product-frame { position:absolute; inset:7% 0 8% 4%; overflow:hidden; border:1px solid rgba(40,199,255,.55); border-radius:30px; background:linear-gradient(135deg,#101f32,#050b15 56%,#101827); box-shadow:-20px 30px 100px rgba(0,0,0,.55),0 0 30px rgba(46,107,255,.18); transform:perspective(1200px) rotateY(-8deg) rotateX(3deg); animation:float 9s ease-in-out infinite; }.product-frame::before { content:''; position:absolute; inset:0; background:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px); background-size:35px 35px; mask-image:linear-gradient(to bottom,black,transparent); }.product-frame__bar { position:absolute; inset:0 0 auto; display:flex; gap:7px; height:44px; padding:17px; border-bottom:1px solid var(--hairline); }.product-frame__bar i { width:6px; height:6px; border-radius:50%; background:var(--text-muted); }.product-frame__wave { position:absolute; width:150%; height:68%; bottom:-20%; left:-25%; border-radius:50% 60% 0 0; background:radial-gradient(ellipse at 40% 60%,rgba(255,75,95,.98),rgba(172,32,64,.7) 32%,transparent 67%); filter:blur(1px); transform:rotate(-11deg); }.product-frame__line { position:absolute; width:130%; height:50%; bottom:15%; left:-10%; border-top:2px solid var(--blue-bright); border-radius:50%; box-shadow:0 -6px 22px rgba(40,199,255,.6); transform:rotate(-8deg); }.product-frame__panel { position:absolute; inset:27% 14% auto auto; width:34%; height:20%; border:1px solid rgba(255,255,255,.22); border-radius:12px; background:rgba(3,7,17,.48); backdrop-filter:blur(7px); }.orbit { position:absolute; z-index:-1; width:78%; height:47%; border:2px solid; border-radius:50%; transform:rotate(-29deg); }.orbit--one { top:8%; right:-8%; border-color:rgba(255,51,77,.62); box-shadow:0 0 25px rgba(255,51,77,.25); animation:drift 10s ease-in-out infinite; }.orbit--two { right:-21%; bottom:6%; border-color:rgba(40,199,255,.55); box-shadow:0 0 22px rgba(40,199,255,.22); animation:drift 12s ease-in-out -3s infinite; }
  @keyframes fade-up { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } } @keyframes visual-in { from { opacity:0; transform:scale(.96) translateY(14px); } to { opacity:1; transform:none; } } @keyframes float { 50% { transform:perspective(1200px) rotateY(-8deg) rotateX(3deg) translateY(-6px); } } @keyframes drift { 50% { transform:rotate(-29deg) translate(5px,-5px); } }
  @media(max-width:900px) { .hero { min-height:auto; padding-block:135px 80px; }.hero__grid { grid-template-columns:1fr; gap:25px; }.hero-visual { min-height:430px; max-width:670px; width:100%; margin:auto; }.product-frame { inset:5% 2% 6% 4%; } }.hero h1{font-size:clamp(51px,8vw,76px);}
  @media(max-width:767px) { .hero { padding-block:120px 58px; }.hero__grid { gap:24px; }.hero h1 { max-width:100%; font-size:clamp(42px,12.8vw,54px); overflow-wrap:anywhere; }.hero__copy { max-width:100%; font-size:17px; overflow-wrap:anywhere; }.hero__actions { display:grid; grid-template-columns:minmax(0,1fr); margin-top:28px; }.hero__actions :global(.button) { width:100%; min-width:0; }.hero__markers { display:flex; flex-wrap:nowrap; justify-content:space-between; gap:0; margin-top:31px; font-size:clamp(8px,2.4vw,10px); white-space:nowrap; }.hero__markers span { min-width:0; }.hero__markers span::before { margin-right:3px; }.hero-visual { min-height:310px; overflow:hidden; border-radius:22px; }.product-frame { inset:5% 7% 6% 5%; border-radius:22px; }.product-frame__panel { display:none; } }
</style>

---
import Logo from '../assets/Logotip.webp';
import { isConfiguredContact, site } from '../data/site';
const isHome = Astro.url.pathname === '/';
const navigation = site.navigation.map((item) => ({ ...item, href: isHome && item.href.startsWith('/#') ? `#${item.id}` : item.href }));
---
<footer class="footer"><div class="footer__inner container"><a class="footer__logo" href={isHome ? '#top' : '/'} aria-label="На главную"><img src={Logo.src} width={Logo.width} height={Logo.height} alt="" /></a><nav aria-label="Навигация в подвале">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav><div class="footer__contacts">{isConfiguredContact(site.telegramUrl) && <a href={site.telegramUrl} target="_blank" rel="noopener noreferrer"><svg class="footer-icon footer-icon--telegram" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.4 3.1 2.9 10.2c-1.3.5-1.3 1.2-.2 1.5l4.7 1.5 1.8 5.5c.2.6.1.9.8.9.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.6c.9.5 1.5.3 1.7-.8l3.1-14.7c.3-1.3-.5-1.9-1.5-1.5Zm-11 10.3-1.7 3.7-1.1-3.8 9.1-5.7-6.3 5.8Z" /></svg>Telegram</a>}{isConfiguredContact(site.email) && <a href={`mailto:${site.email}`}><svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="#EA4335" d="M3 6.3 12 13l9-6.7V18a2 2 0 0 1-2 2h-2V10.1l-5 3.7-5-3.7V20H5a2 2 0 0 1-2-2V6.3Z" /><path fill="#4285F4" d="M3 6.3 5.2 5 12 10l6.8-5L21 6.3 12 13 3 6.3Z" /></svg>Email</a>}</div><p>© {new Date().getFullYear()}</p></div></footer>
<style>.footer { padding:35px 0; border-top:1px solid rgba(40,199,255,.22); background:#0d192a; }.footer__inner { display:flex; align-items:center; gap:24px; color:var(--text-muted); font-size:13px; }.footer__logo img { width:auto; height:68px; filter:drop-shadow(0 3px 12px rgba(40,199,255,.32)); animation:footer-logo-glow 5s ease-in-out infinite; }.footer nav,.footer__contacts { display:flex; flex-wrap:wrap; gap:16px; }.footer nav { margin-left:auto; }.footer__contacts a { display:inline-flex; align-items:center; gap:5px; }.footer-icon { width:15px !important; height:15px !important; flex:0 0 15px; }.footer-icon--telegram { color:var(--blue-bright); }.footer a:hover { color:var(--text-primary); }.footer p { margin:0 0 0 auto; } @keyframes footer-logo-glow { 50% { transform:translateY(-4px) scale(1.02); filter:drop-shadow(0 3px 18px rgba(40,199,255,.56)); } } @media(max-width:767px) { .footer__inner { display:grid; grid-template-columns:1fr; gap:23px; }.footer__logo { justify-self:center; width:50%; }.footer__logo img { width:100%; height:auto; }.footer nav { grid-column:auto; justify-content:center; margin:0; text-align:center; }.footer__contacts { grid-column:auto; justify-content:center; gap:16px; }.footer__contacts a { display:inline-flex; align-items:center; justify-content:center; gap:6px; min-width:92px; min-height:36px; }.footer-icon { width:18px !important; height:18px !important; flex:0 0 18px; }.footer p { justify-self:end; margin:0; } }</style>

---
import Logo from '../assets/Logotip.webp';
import Button from './Button.astro';
---
<section class="section about" id="about"><div class="about__grid container"><div class="about__visual reveal" aria-label="Брендовый визуальный блок"><div class="about__glow"></div><img src={Logo.src} width={Logo.width} height={Logo.height} alt="" /><span>digital products</span></div><div class="about__content reveal"><p class="eyebrow">ОБО МНЕ</p><h2 class="section-heading">Кто я</h2><p class="section-copy">Я создаю современные сайты и цифровые продукты для бизнеса, стартапов и экспертов. Объединяю проектирование, разработку и современные AI-инструменты, чтобы доводить продукт от идеи до запуска.</p><ul class="about__chips"><li>Бизнес-задача прежде интерфейса</li><li>От идеи до запуска</li><li>Современный подход</li><li>Прямое взаимодействие</li></ul><Button href="#contact" variant="secondary">Обсудить проект</Button></div></div></section>
<style>.about__grid { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:clamp(40px,7vw,120px); }.about__visual { position:relative; display:flex; min-height:465px; align-items:center; justify-content:center; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-lg); background:linear-gradient(145deg,#0e1d30,#060b14); }.about__visual::before { content:''; position:absolute; width:115%; height:65%; border:1px solid rgba(40,199,255,.35); border-radius:50%; transform:rotate(-30deg); animation:orbit-shift 10s ease-in-out infinite; }.about__glow { position:absolute; width:80%; aspect-ratio:1; border-radius:50%; background:radial-gradient(circle,rgba(255,51,77,.48),rgba(46,107,255,.23) 42%,transparent 70%); animation:glow-breathe 7s ease-in-out infinite; }.about__visual img { position:relative; z-index:1; width:min(72%,340px); height:auto; filter:drop-shadow(0 14px 32px rgba(0,0,0,.42)); animation:logo-float 7s ease-in-out infinite; }.about__visual span { position:absolute; right:25px; bottom:23px; color:var(--text-muted); font-size:11px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; }.about__content .section-heading { margin-bottom:22px; }.about__chips { display:flex; flex-wrap:wrap; gap:9px; margin:32px 0; padding:0; list-style:none; }.about__chips li { padding:8px 11px; border:1px solid var(--hairline); border-radius:99px; color:var(--text-secondary); font-size:13px; } @keyframes logo-float { 50% { transform:translateY(-8px) scale(1.015); } } @keyframes glow-breathe { 50% { transform:scale(1.1); opacity:.75; } } @keyframes orbit-shift { 50% { transform:rotate(-26deg) translate(8px,-5px); } } @media(max-width:767px) { .about__grid { grid-template-columns:1fr; gap:35px; }.about__visual { min-height:330px; }.about__content :global(.button) { width:100%; } }</style>

---
import SectionHeader from './SectionHeader.astro';
const steps = [
  ['01','Разбираюсь в задаче','Изучаю продукт, аудиторию, цели и ограничения.'],
  ['02','Проектирую','Определяю структуру, сценарии и логику продукта.'],
  ['03','Создаю','Проектирую интерфейс, разрабатываю и интегрирую.'],
  ['04','Запускаю','Тестирую, адаптирую, подключаю и запускаю.'],
];
---
<section class="section process" id="process"><div class="container"><SectionHeader eyebrow="ПРОЦЕСС РАБОТЫ" title="Как я работаю" /><ol class="process__list">{steps.map(([number, title, copy], index) => <li class="reveal" style={`transition-delay:${index * 80}ms`}><span class="process__number">{number}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>
<style>.process { background:var(--bg-secondary); }.process__list { display:grid; grid-template-columns:repeat(4,1fr); gap:26px; margin:55px 0 0; padding:0; list-style:none; }.process__list li { position:relative; }.process__list li:not(:last-child)::after { content:''; position:absolute; top:24px; left:60px; width:calc(100% - 42px); height:1px; background:linear-gradient(90deg,rgba(255,51,77,.55),rgba(46,107,255,.4)); }.process__number { position:relative; z-index:1; display:grid; width:49px; height:49px; place-items:center; border:1px solid rgba(46,107,255,.5); border-radius:50%; background:var(--surface); color:var(--blue-bright); font-family:'Space Grotesk',sans-serif; font-size:13px; font-weight:700; }.process__list li:nth-child(even) .process__number { border-color:rgba(255,51,77,.5); color:var(--red-bright); }.process h3 { margin:27px 0 10px; font-size:23px; line-height:1.15; letter-spacing:-.03em; }.process p { max-width:230px; margin:0; color:var(--text-secondary); } @media(max-width:767px) { .process__list { grid-template-columns:1fr; gap:30px; margin-top:38px; }.process__list li { display:grid; grid-template-columns:50px 1fr; column-gap:18px; }.process__list li:not(:last-child)::after { top:57px; left:24px; width:1px; height:calc(100% + 1px); background:linear-gradient(var(--blue),rgba(255,51,77,.4)); }.process h3 { margin:5px 0 9px; }.process p { grid-column:2; } }</style>

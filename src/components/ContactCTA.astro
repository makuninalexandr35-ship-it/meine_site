---
import Button from './Button.astro';
import { isConfiguredContact, site } from '../data/site';
const telegramReady = isConfiguredContact(site.telegramUrl);
const emailReady = isConfiguredContact(site.email);
---
<section class="section contact" id="contact"><div class="contact__surface container reveal"><div class="contact__ribbon contact__ribbon--red" aria-hidden="true"></div><div class="contact__ribbon contact__ribbon--blue" aria-hidden="true"></div><div class="contact__content"><p class="eyebrow">КОНТАКТ</p><h2>Давайте обсудим<br /><span class="gradient-text">ваш проект.</span></h2><p>Расскажите о задаче — обсудим, что нужно создать и как лучше подойти к реализации.</p><div class="contact__actions">{telegramReady ? <Button href={site.telegramUrl} external size="lg">Написать в Telegram</Button> : <span class="contact__unavailable">Telegram: добавьте ссылку в site.ts</span>}{emailReady ? <a class="email-link" href={`mailto:${site.email}`}>Написать на Email <span aria-hidden="true">↗</span></a> : <span class="contact__unavailable">Email: добавьте адрес в site.ts</span>}</div></div></div></section>
<style>.contact { padding-top:clamp(72px,10vw,150px); }.contact__surface { position:relative; overflow:hidden; min-height:500px; padding:clamp(38px,7vw,105px); border:1px solid rgba(46,107,255,.35); border-radius:var(--radius-lg); background:linear-gradient(130deg,#0a1828 0%,#08111e 53%,#150b18 100%); }.contact__content { position:relative; z-index:1; max-width:680px; }.contact h2 { margin-bottom:23px; font-size:clamp(46px,5.5vw,83px); line-height:.98; letter-spacing:-.055em; }.contact__content > p:not(.eyebrow) { max-width:540px; color:var(--text-secondary); font-size:18px; }.contact__actions { display:flex; flex-wrap:wrap; align-items:center; gap:18px; margin-top:35px; }.email-link { display:inline-flex; align-items:center; gap:9px; min-height:48px; color:var(--text-primary); font-weight:800; }.email-link span { color:var(--blue-bright); }.contact__unavailable { color:var(--text-secondary); font-size:14px; }.contact__ribbon { position:absolute; border:2px solid; border-radius:50%; transform:rotate(-25deg); }.contact__ribbon--red { width:90%; height:58%; right:-27%; top:-21%; border-color:rgba(255,51,77,.58); box-shadow:0 0 50px rgba(255,51,77,.2); }.contact__ribbon--blue { width:92%; height:62%; right:-22%; bottom:-33%; border-color:rgba(40,199,255,.52); box-shadow:0 0 50px rgba(46,107,255,.2); } @media(max-width:767px) { .contact__surface { min-height:0; }.contact__content > p:not(.eyebrow) { font-size:16px; }.contact__actions { display:grid; grid-template-columns:1fr; }.contact__actions :global(.button) { width:100%; }.email-link { justify-content:center; }.contact__ribbon--red { width:130%; right:-60%; }.contact__ribbon--blue { width:135%; right:-64%; } }</style>

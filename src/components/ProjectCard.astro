---
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="project-card reveal">
  <a href={`/project/${project.slug}/`} aria-label={`Открыть проект: ${project.title}`}>
    <div class="project-card__visual">
      <img src={project.cover} alt={project.coverAlt} loading="lazy" />
      <div class="project-card__placeholder" aria-hidden="true"><span>{project.category}</span></div>
    </div>
    <div class="project-card__meta"><div><span class="pill">{project.category}</span><h3>{project.title}</h3><p>{project.shortDescription}</p></div><span class="project-card__arrow" aria-hidden="true">↗</span></div>
  </a>
</article>
<style>
  .project-card { overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-md); background:var(--surface); transition:transform var(--transition),border-color var(--transition),box-shadow var(--transition); }.project-card a { display:block; }.project-card__visual { position:relative; aspect-ratio:16/9.7; overflow:hidden; background:linear-gradient(135deg,#102541,#120c18); }.project-card__visual img { width:100%; height:100%; object-fit:cover; transition:transform 420ms ease; }.project-card__placeholder { position:absolute; right:14px; bottom:14px; display:inline-flex; padding:8px 10px; border:1px solid rgba(244,247,251,.22); border-radius:999px; background:rgba(3,7,17,.68); color:rgba(244,247,251,.82); font-family:'Space Grotesk',sans-serif; font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; backdrop-filter:blur(8px); }.project-card__meta { display:flex; justify-content:space-between; gap:18px; min-height:152px; padding:23px 24px 25px; }.pill { color:var(--blue-bright); font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }.project-card h3 { margin:8px 0 5px; font-size:clamp(24px,2vw,32px); line-height:1.1; letter-spacing:-.035em; }.project-card p { margin:0; color:var(--text-secondary); }.project-card__arrow { align-self:center; display:grid; width:42px; height:42px; flex:0 0 42px; place-items:center; border:1px solid var(--hairline); border-radius:50%; color:var(--blue-bright); font-size:20px; transition:transform var(--transition),background var(--transition); }.project-card:hover,.project-card:focus-within { transform:translateY(-4px); border-color:rgba(40,199,255,.46); box-shadow:0 18px 45px rgba(0,0,0,.28),0 0 28px rgba(46,107,255,.12); }.project-card:hover img,.project-card:focus-within img { transform:scale(1.035); }.project-card:hover .project-card__arrow,.project-card:focus-within .project-card__arrow { transform:translate(4px,-3px); background:rgba(46,107,255,.15); }
</style>

---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Button from '../../components/Button.astro';
import { publishedProjects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return publishedProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
const index = publishedProjects.findIndex((item) => item.slug === project.slug);
const nextProject = publishedProjects[index + 1];
const details = [
  ['О проекте', project.description],
  ['Задача', project.challenge],
  ['Решение', project.solution],
  ['Моя роль', project.role?.join(' · ')],
  ['Функционал', project.services?.join(' · ')],
  ['Технологии', project.technologies?.join(' · ')],
  ['Результат', project.result],
].filter(([, content]) => content && !content.startsWith('TODO:'));
---
<ProjectLayout project={project}>
  <article class="case-study container">
    <a class="back-link" href="/#works">← Все проекты</a>
    <header class="case-study__header"><p class="eyebrow">{project.category}{project.year ? ` · ${project.year}` : ''}</p><h1>{project.title}</h1><p>{project.shortDescription}</p>{project.liveUrl && <Button href={project.liveUrl} external>Посмотреть сайт</Button>}</header>
    <img class="case-study__cover" src={project.cover} alt={project.coverAlt} loading="eager" />
    {details.length > 0 && <div class="case-study__details">{details.map(([heading, content]) => <section><h2>{heading}</h2><p>{content}</p></section>)}</div>}
    {project.gallery?.length ? <section class="gallery" aria-label="Галерея проекта">{project.gallery.map((image) => <img src={image.src} alt={image.alt} loading="lazy" />)}</section> : null}
    {project.video ? <section class="project-video" aria-labelledby="project-video-title"><p class="eyebrow">ВИДЕООБЗОР</p><h2 id="project-video-title">{project.video.title}</h2><video controls playsinline preload="metadata" poster={project.cover}><source src={project.video.src} type="video/mp4" />Ваш браузер не поддерживает видео.</video></section> : null}
    <section class="case-study__cta"><p class="eyebrow">ПОХОЖАЯ ЗАДАЧА?</p><h2>Давайте обсудим проект.</h2><Button href="/#contact">Обсудить проект</Button></section>
    {nextProject ? <a class="next-project" href={`/project/${nextProject.slug}/`}><span>Следующий проект</span><strong>{nextProject.title}</strong><b aria-hidden="true">→</b></a> : <a class="next-project" href="/#works"><span>ПОРТФОЛИО</span><strong>Вернуться ко всем проектам</strong><b aria-hidden="true">→</b></a>}
  </article>
</ProjectLayout>
<style>.case-study { padding-top:calc(var(--header-height) + 62px); padding-bottom:90px; }.back-link { display:inline-flex; min-height:44px; align-items:center; color:var(--text-secondary); font-weight:700; }.back-link:hover { color:var(--blue-bright); }.case-study__header { min-height:54svh; display:flex; flex-direction:column; justify-content:center; max-width:980px; }.case-study__header h1 { margin:0 0 22px; font-size:clamp(55px,7vw,106px); line-height:.96; letter-spacing:-.06em; }.case-study__header > p:not(.eyebrow) { max-width:680px; color:var(--text-secondary); font-size:clamp(18px,2vw,23px); }.case-study__header :global(.button) { align-self:flex-start; margin-top:14px; }.case-study__cover { width:100%; aspect-ratio:16/8.8; object-fit:cover; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface); }.case-study__details { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; margin-top:70px; border:1px solid var(--border); background:var(--border); }.case-study__details section { min-height:180px; padding:28px; background:var(--bg-main); }.case-study__details h2 { margin:0 0 12px; font-size:27px; letter-spacing:-.04em; }.case-study__details p { margin:0; color:var(--text-secondary); }.gallery { display:grid; gap:24px; margin-top:55px; }.gallery img { width:100%; border:1px solid var(--border); border-radius:var(--radius-md); }.project-video { margin-top:55px; }.project-video h2 { margin-bottom:22px; font-size:clamp(34px,4vw,56px); letter-spacing:-.05em; }.project-video video { display:block; width:100%; max-height:78svh; border:1px solid var(--border); border-radius:var(--radius-md); background:var(--surface); }.case-study__cta { padding:90px 0 55px; }.case-study__cta h2 { font-size:clamp(38px,4.5vw,62px); letter-spacing:-.05em; }.next-project { display:grid; grid-template-columns:1fr auto; gap:10px; padding:35px; border:1px solid var(--border); border-radius:var(--radius-md); background:radial-gradient(circle at 90% 20%,rgba(46,107,255,.18),transparent 30%),var(--surface); transition:transform var(--transition),border-color var(--transition); }.next-project:hover { transform:translateY(-3px); border-color:rgba(40,199,255,.5); }.next-project span { color:var(--text-muted); font-size:12px; font-weight:800; letter-spacing:.18em; }.next-project strong { font-family:'Space Grotesk',sans-serif; font-size:clamp(28px,4vw,48px); letter-spacing:-.05em; }.next-project b { grid-column:2; grid-row:1/3; align-self:center; color:var(--blue-bright); font-size:28px; } @media(max-width:767px) { .case-study { padding-top:calc(var(--header-height) + 30px); }.case-study__header { min-height:45svh; }.case-study__details { grid-template-columns:1fr; margin-top:40px; }.case-study__details section { min-height:0; }.project-video { margin-top:40px; }.case-study__cta { padding:65px 0 35px; }.next-project { padding:24px; } }</style>

---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Button from '../../components/Button.astro';
import { publishedProjects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return publishedProjects.filter((project) => !project.customPage).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
const index = publishedProjects.findIndex((item) => item.slug === project.slug);
const nextProject = publishedProjects[index + 1];
const otherProjects = publishedProjects.filter((item) => item.slug !== project.slug).sort((a, b) => Number(Boolean(b.customPage)) - Number(Boolean(a.customPage))).slice(0, 3);
const regularGallery = project.gallery?.filter((image) => !image.compact) ?? [];
const compactGallery = project.gallery?.filter((image) => image.compact) ?? [];
const details = [
  ['О проекте', project.description],
  ['Задача', project.challenge],
  ['Решение', project.solution],
  ['Моя роль', project.role?.join(' · ')],
  ['Функционал', project.services?.join(' · ')],
  ['Технологии', project.technologies?.join(' · ')],
  ['Результат', project.result],
].filter(([, content]) => content && !content.startsWith('TODO:'));
---
<ProjectLayout project={project}>
  <article class="case-study container">
    <a class="back-link" href="/#works">← Все проекты</a>
    <header class="case-study__header"><p class="eyebrow">{project.category}{project.year ? ` · ${project.year}` : ''}</p><h1>{project.title}</h1><p>{project.shortDescription}</p>{project.liveUrl && <Button href={project.liveUrl} external>Посмотреть сайт</Button>}</header>
    <img class="case-study__cover" src={project.cover} alt={project.coverAlt} loading="eager" />
    {details.length > 0 && <div class="case-study__details">{details.map(([heading, content]) => <section><h2>{heading}</h2><p>{content}</p></section>)}</div>}
    {project.gallery?.length ? <>
      <section class="gallery" aria-label="Галерея проекта">
        {regularGallery.map((image) => <button class="gallery__item" type="button" data-gallery-image data-src={image.src} data-alt={image.alt} aria-label={`Открыть изображение: ${image.alt}`}><img src={image.src} alt={image.alt} loading="lazy" /></button>)}
        {compactGallery.length ? <div class="gallery__compact" aria-label="Дополнительные экраны проекта">{compactGallery.map((image) => <button class="gallery__item gallery__item--compact" type="button" data-gallery-image data-src={image.src} data-alt={image.alt} aria-label={`Открыть изображение: ${image.alt}`}><img src={image.src} alt={image.alt} loading="lazy" /></button>)}</div> : null}
      </section>
      <dialog class="gallery-lightbox" data-gallery-lightbox aria-label="Просмотр изображения">
        <button class="gallery-lightbox__close" type="button" data-gallery-close aria-label="Закрыть просмотр">×</button>
        <img data-gallery-lightbox-image alt="" />
      </dialog>
    </> : null}
    {project.video ? <section class="project-video" aria-labelledby="project-video-title"><p class="eyebrow">ВИДЕООБЗОР</p><h2 id="project-video-title">{project.video.title}</h2><video controls playsinline preload="metadata" poster={project.cover}><source src={project.video.src} type="video/mp4" />Ваш браузер не поддерживает видео.</video></section> : null}
    <section class="case-study__cta"><p class="eyebrow">ПОХОЖАЯ ЗАДАЧА?</p><h2>Давайте обсудим проект.</h2><Button href={site.projectRequestUrl}>Обсудить проект</Button></section>
    {otherProjects.length > 0 ? <section class="other-projects" aria-labelledby="other-projects-title"><p class="eyebrow">ПОРТФОЛИО</p><h2 id="other-projects-title">Другие проекты</h2><ul class="other-projects__list">{otherProjects.map((item) => <li><a href={`/project/${item.slug}/`}><span class="other-projects__category">{item.category}</span><strong>{item.title}</strong><span class="other-projects__text">{item.shortDescription}</span></a></li>)}</ul></section> : null}
    {nextProject ? <a class="next-project" href={`/project/${nextProject.slug}/`}><span>Следующий проект</span><strong>{nextProject.title}</strong><b aria-hidden="true">→</b></a> : <a class="next-project" href="/#works"><span>ПОРТФОЛИО</span><strong>Вернуться ко всем проектам</strong><b aria-hidden="true">→</b></a>}
  </article>
</ProjectLayout>
<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
  const lightboxImage = document.querySelector<HTMLImageElement>('[data-gallery-lightbox-image]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-gallery-close]');

  document.querySelectorAll<HTMLButtonElement>('[data-gallery-image]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = button.dataset.src ?? '';
      lightboxImage.alt = button.dataset.alt ?? '';
      lightbox.showModal();
    });
  });

  closeButton?.addEventListener('click', () => lightbox?.close());
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>
<style>.case-study { padding-top:calc(var(--header-height) + 62px); padding-bottom:90px; }.back-link { display:inline-flex; min-height:44px; align-items:center; color:var(--text-secondary); font-weight:700; }.back-link:hover { color:var(--blue-bright); }.case-study__header { min-height:54svh; display:flex; flex-direction:column; justify-content:center; max-width:980px; }.case-study__header h1 { margin:0 0 22px; font-size:clamp(55px,7vw,106px); line-height:.96; letter-spacing:-.06em; }.case-study__header > p:not(.eyebrow) { max-width:680px; color:var(--text-secondary); font-size:clamp(18px,2vw,23px); }.case-study__header :global(.button) { align-self:flex-start; margin-top:14px; }.case-study__cover { width:100%; aspect-ratio:16/8.8; object-fit:cover; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface); }.case-study__details { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; margin-top:70px; border:1px solid var(--border); background:var(--border); }.case-study__details section { min-height:180px; padding:28px; background:var(--bg-main); }.case-study__details h2 { margin:0 0 12px; font-size:27px; letter-spacing:-.04em; }.case-study__details p { margin:0; color:var(--text-secondary); }.gallery { display:grid; gap:24px; margin-top:55px; }.gallery__compact { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; width:min(100%,960px); margin:0 auto; }.gallery__item { display:block; width:100%; padding:0; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-md); background:var(--surface); cursor:zoom-in; }.gallery__item img { display:block; width:100%; transition:transform 260ms ease; }.gallery__item:hover img,.gallery__item:focus-visible img { transform:scale(1.015); }.gallery__item:focus-visible { outline:2px solid var(--blue-bright); outline-offset:4px; }.gallery-lightbox { width:min(94vw,1440px); max-width:none; max-height:90dvh; padding:38px 18px 18px; overflow:hidden; border:1px solid rgba(137,179,255,.42); border-radius:var(--radius-md); background:rgba(5,10,23,.96); box-shadow:0 30px 90px rgba(0,0,0,.62); }.gallery-lightbox::backdrop { background:rgba(0,0,0,.84); backdrop-filter:blur(8px); }.gallery-lightbox img { display:block; max-width:100%; max-height:calc(90dvh - 58px); margin:auto; object-fit:contain; }.gallery-lightbox__close { position:absolute; top:8px; right:10px; display:grid; width:34px; height:34px; place-items:center; border:1px solid var(--hairline); border-radius:50%; background:rgba(9,19,36,.9); color:var(--text-primary); font-size:26px; line-height:1; cursor:pointer; }.gallery-lightbox__close:hover,.gallery-lightbox__close:focus-visible { border-color:var(--blue-bright); color:var(--blue-bright); }.project-video { margin-top:55px; }.project-video h2 { margin-bottom:22px; font-size:clamp(34px,4vw,56px); letter-spacing:-.05em; }.project-video video { display:block; width:100%; max-height:78svh; border:1px solid var(--border); border-radius:var(--radius-md); background:var(--surface); }.case-study__cta { padding:90px 0 55px; }.case-study__cta h2 { font-size:clamp(38px,4.5vw,62px); letter-spacing:-.05em; }.next-project { display:grid; grid-template-columns:1fr auto; gap:10px; padding:35px; border:1px solid var(--border); border-radius:var(--radius-md); background:radial-gradient(circle at 90% 20%,rgba(46,107,255,.18),transparent 30%),var(--surface); transition:transform var(--transition),border-color var(--transition); }.next-project:hover { transform:translateY(-3px); border-color:rgba(40,199,255,.5); }.next-project span { color:var(--text-muted); font-size:12px; font-weight:800; letter-spacing:.18em; }.next-project strong { font-family:'Space Grotesk',sans-serif; font-size:clamp(28px,4vw,48px); letter-spacing:-.05em; }.next-project b { grid-column:2; grid-row:1/3; align-self:center; color:var(--blue-bright); font-size:28px; }.other-projects { margin:0 0 55px; }.other-projects h2 { margin:0 0 26px; font-size:clamp(34px,4vw,56px); letter-spacing:-.05em; }.other-projects__list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin:0; padding:0; list-style:none; }.other-projects__list a { display:flex; height:100%; flex-direction:column; gap:8px; padding:24px; border:1px solid var(--border); border-radius:var(--radius-md); background:var(--surface); transition:transform var(--transition),border-color var(--transition); }.other-projects__list a:hover,.other-projects__list a:focus-visible { transform:translateY(-3px); border-color:rgba(40,199,255,.5); }.other-projects__category { color:var(--blue-bright); font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }.other-projects__list strong { font-family:'Space Grotesk',sans-serif; font-size:clamp(22px,2.2vw,28px); line-height:1.1; letter-spacing:-.04em; }.other-projects__text { color:var(--text-secondary); } @media(max-width:767px) { .other-projects__list { grid-template-columns:1fr; } .case-study { padding-top:calc(var(--header-height) + 30px); }.case-study__header { min-height:45svh; }.case-study__details { grid-template-columns:1fr; margin-top:40px; }.case-study__details section { min-height:0; }.gallery__compact { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }.project-video { margin-top:40px; }.case-study__cta { padding:65px 0 35px; }.next-project { padding:24px; } .gallery-lightbox { width:calc(100vw - 24px); } }</style>

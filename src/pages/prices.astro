---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { additionalServices, priceGroups } from '../data/pricing';
---
<BaseLayout
  title="Цены на разработку сайтов, SEO и AI-решения"
  description="Стоимость разработки сайтов, WordPress, Telegram-ботов, AI-решений, автоматизации и SEO. Понятные стартовые цены на цифровые проекты."
  canonicalPath="/prices/"
>
  <section class="prices-hero">
    <div class="container prices-hero__inner">
      <p class="eyebrow">УСЛУГИ И ЦЕНЫ</p>
      <h1>Стоимость <span class="gradient-text">разработки</span></h1>
      <p>Понятные стартовые цены без скрытых условий. Финальная стоимость зависит от сложности, объёма работ и необходимых интеграций.</p>
      <Button href="/#contact" size="lg">Обсудить проект</Button>
    </div>
  </section>

  <section class="prices-section" aria-labelledby="main-prices-title">
    <div class="container">
      <header class="prices-section__header reveal">
        <p class="eyebrow">ОСНОВНЫЕ НАПРАВЛЕНИЯ</p>
        <h2 id="main-prices-title">Что можно заказать</h2>
      </header>

      {priceGroups.map((group) => (
        <section class="price-group" aria-labelledby={`group-${group.title}`}>
          <header class="price-group__header reveal">
            <h2 id={`group-${group.title}`}>{group.title}</h2>
            <p>{group.copy}</p>
          </header>
          <div class="price-grid">
            {group.items.map((item, index) => (
              <article class="price-card reveal" style={`transition-delay:${index * 65}ms`}>
                <div class="price-card__top">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <p class="price-card__value"><span>от</span> {item.amount}</p>
                <ul>
                  {item.details.map((detail) => <li>{detail}</li>)}
                </ul>
                <a href="/#contact" aria-label={`Обсудить услугу: ${item.title}`}>Обсудить проект <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="prices-section prices-section--compact" aria-labelledby="additional-title">
    <div class="container">
      <header class="prices-section__header reveal">
        <p class="eyebrow">ДОПОЛНИТЕЛЬНЫЕ ЗАДАЧИ</p>
        <h2 id="additional-title">Отдельные работы</h2>
        <p>Их можно добавить к новому проекту или заказать для уже работающего сайта.</p>
      </header>
      <ul class="additional-list reveal">
        {additionalServices.map(([title, amount]) => <li><span>{title}</span><strong><small>от</small> {amount}</strong></li>)}
      </ul>
    </div>
  </section>

  <section class="prices-section prices-section--note" aria-labelledby="why-from-title">
    <div class="container">
      <div class="price-note reveal">
        <div>
          <p class="eyebrow">ПОДХОД К ОЦЕНКЕ</p>
          <h2 id="why-from-title">Почему указано «от»?</h2>
        </div>
        <div>
          <p>Каждый проект отличается по объёму и функциональности. Я сначала уточняю задачу, после чего называю окончательную стоимость до начала разработки.</p>
          <p>Стартовые цены позволяют заранее понять примерный бюджет проекта.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="prices-section prices-section--factors" aria-labelledby="factors-title">
    <div class="container">
      <header class="prices-section__header reveal">
        <p class="eyebrow">ПЛАНИРОВАНИЕ</p>
        <h2 id="factors-title">Что влияет на стоимость</h2>
      </header>
      <ul class="factors reveal">
        <li>Количество страниц</li><li>Сложность дизайна</li><li>Интеграции</li><li>Формы и автоматизация</li><li>База данных</li><li>Личный кабинет</li><li>AI-функции</li><li>Объём SEO-работ</li><li>Доработка существующего проекта</li>
      </ul>
    </div>
  </section>

  <section class="prices-cta" aria-labelledby="prices-cta-title">
    <div class="container prices-cta__surface reveal">
      <div>
        <p class="eyebrow">СЛЕДУЮЩИЙ ШАГ</p>
        <h2 id="prices-cta-title">Не знаете, сколько будет стоить ваш проект?</h2>
        <p>Опишите задачу — я оценю объём работы и назову стоимость до начала разработки.</p>
      </div>
      <Button href="/#contact" size="lg">Обсудить проект</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .prices-hero,.prices-section,.prices-cta { position:relative; }.prices-hero { overflow:hidden; padding:calc(var(--header-height) + 88px) 0 110px; background:radial-gradient(circle at 82% 18%,rgba(46,107,255,.19),transparent 28%),radial-gradient(circle at 14% 85%,rgba(255,51,77,.13),transparent 30%); }.prices-hero::after { content:''; position:absolute; width:54vw; height:32vw; right:-17vw; bottom:-23vw; border:1px solid rgba(40,199,255,.27); border-radius:50%; transform:rotate(-19deg); }.prices-hero__inner { position:relative; z-index:1; max-width:1100px; }.prices-hero h1 { max-width:770px; margin-bottom:24px; font-size:clamp(52px,6.4vw,92px); line-height:.97; letter-spacing:-.06em; }.prices-hero p:not(.eyebrow) { max-width:690px; margin-bottom:34px; color:var(--text-secondary); font-size:clamp(18px,1.5vw,21px); }
  .prices-section { padding:clamp(72px,9vw,132px) 0; }.prices-section--compact { padding-top:0; }.prices-section--note { padding-top:0; }.prices-section--factors { padding-top:0; }.prices-section__header { max-width:720px; margin-bottom:46px; }.prices-section__header h2,.price-note h2,.prices-cta h2 { margin-bottom:16px; font-size:clamp(38px,4.5vw,66px); line-height:1.03; letter-spacing:-.05em; }.prices-section__header > p:last-child { color:var(--text-secondary); font-size:18px; }
  .price-group + .price-group { margin-top:76px; }.price-group__header { display:flex; align-items:baseline; justify-content:space-between; gap:30px; margin-bottom:24px; }.price-group__header h2 { margin:0; font-size:clamp(29px,3vw,42px); letter-spacing:-.045em; }.price-group__header p { max-width:500px; margin:0; color:var(--text-secondary); }.price-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }.price-card { display:flex; flex-direction:column; min-width:0; padding:30px; border:1px solid rgba(122,157,205,.2); border-radius:var(--radius-md); background:linear-gradient(140deg,rgba(13,25,42,.9),rgba(5,11,21,.86)); transition:border-color var(--transition),transform var(--transition),background var(--transition); }.price-card:hover { border-color:rgba(40,199,255,.45); transform:translateY(-3px); background:linear-gradient(140deg,rgba(16,34,55,.94),rgba(5,11,21,.9)); }.price-card__top h3 { margin-bottom:9px; font-size:27px; letter-spacing:-.04em; }.price-card__top p { margin-bottom:23px; color:var(--text-secondary); }.price-card__value { margin:0 0 24px; color:var(--blue-bright); font-family:'Space Grotesk',sans-serif; font-size:clamp(28px,3vw,40px); font-weight:700; letter-spacing:-.045em; line-height:1; white-space:nowrap; }.price-card__value span,.additional-list small { font-size:.55em; font-weight:600; letter-spacing:0; }.price-card ul { display:grid; gap:9px; min-height:88px; margin:0 0 25px; padding:0; list-style:none; color:var(--text-secondary); font-size:14px; }.price-card li::before { content:'•'; margin-right:9px; color:var(--red-bright); }.price-card a { display:inline-flex; align-items:center; gap:8px; margin-top:auto; color:var(--text-primary); font-size:14px; font-weight:800; }.price-card a span { color:var(--blue-bright); transition:transform var(--transition); }.price-card a:hover span { transform:translateX(4px); }
  .additional-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; margin:0; padding:1px; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-md); background:var(--border); list-style:none; }.additional-list li { display:flex; align-items:center; justify-content:space-between; gap:12px; min-width:0; padding:18px; background:var(--surface); }.additional-list span { color:var(--text-secondary); font-size:14px; }.additional-list strong { flex:0 0 auto; color:var(--blue-bright); font-family:'Space Grotesk',sans-serif; font-size:17px; white-space:nowrap; }
  .price-note { display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(36px,7vw,120px); padding:clamp(30px,5vw,70px); border:1px solid rgba(40,199,255,.26); border-radius:var(--radius-lg); background:linear-gradient(120deg,rgba(9,25,42,.86),rgba(13,12,28,.76)); }.price-note h2 { margin-bottom:0; }.price-note p { margin-bottom:14px; color:var(--text-secondary); font-size:17px; }.price-note p:last-child { margin-bottom:0; }
  .factors { display:flex; flex-wrap:wrap; gap:10px; margin:0; padding:0; list-style:none; }.factors li { padding:10px 14px; border:1px solid rgba(40,199,255,.22); border-radius:999px; background:rgba(9,19,33,.58); color:var(--text-secondary); font-size:14px; }.prices-cta { padding:0 0 clamp(72px,10vw,150px); }.prices-cta__surface { display:flex; align-items:center; justify-content:space-between; gap:32px; padding:clamp(34px,6vw,82px); overflow:hidden; border:1px solid rgba(46,107,255,.38); border-radius:var(--radius-lg); background:radial-gradient(circle at 100% 50%,rgba(255,51,77,.15),transparent 35%),linear-gradient(130deg,#0a1828,#08111e 56%,#150b18); }.prices-cta__surface > div { max-width:700px; }.prices-cta h2 { max-width:660px; }.prices-cta p:not(.eyebrow) { margin:0; color:var(--text-secondary); font-size:18px; }.prices-cta :global(.button) { flex:0 0 auto; }
  @media(max-width:900px) { .additional-list { grid-template-columns:repeat(2,minmax(0,1fr)); }.prices-cta__surface { align-items:flex-start; flex-direction:column; } }
  @media(max-width:767px) { .prices-hero { padding:calc(var(--header-height) + 52px) 0 74px; }.prices-hero::after { width:100vw; height:54vw; right:-38vw; bottom:-27vw; }.prices-hero h1 { font-size:clamp(43px,13.5vw,58px); }.prices-hero p:not(.eyebrow) { font-size:16px; }.prices-hero :global(.button) { width:100%; }.prices-section { padding:74px 0; }.prices-section__header { margin-bottom:32px; }.prices-section__header > p:last-child { font-size:16px; }.price-group + .price-group { margin-top:54px; }.price-group__header { display:block; margin-bottom:18px; }.price-group__header h2 { margin-bottom:10px; }.price-grid { grid-template-columns:1fr; }.price-card { padding:23px; }.price-card__top h3 { font-size:25px; }.price-card__value { font-size:34px; }.price-card ul { min-height:0; }.additional-list { grid-template-columns:1fr; }.additional-list li { padding:15px; }.price-note { grid-template-columns:1fr; gap:24px; border-radius:var(--radius-md); }.price-note p { font-size:16px; }.factors { gap:8px; }.factors li { font-size:13px; }.prices-cta { padding-bottom:74px; }.prices-cta__surface { gap:25px; border-radius:var(--radius-md); }.prices-cta p:not(.eyebrow) { font-size:16px; }.prices-cta :global(.button) { width:100%; } }
</style>

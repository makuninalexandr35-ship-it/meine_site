---
import BaseLayout from '../layouts/BaseLayout.astro';

const directions = [
  ['Сайты', 'Лендинги, корпоративные сайты и продуктовые страницы.'],
  ['Веб-сервисы', 'Сервисы, личные кабинеты и интерфейсы для рабочих процессов.'],
  ['AI-решения', 'Интеграции и автоматизация задач, в которых AI даёт практический результат.'],
  ['Telegram-боты', 'Боты и интеграции под конкретные процессы бизнеса.'],
];
---
<BaseLayout title="Ориентиры по бюджету — сайты и AI-решения" description="Ориентиры по бюджету на разработку сайтов, веб-сервисов, AI-решений и Telegram-ботов.">
  <section class="prices">
    <div class="container prices__inner">
      <p class="eyebrow">ОРИЕНТИРЫ ПО БЮДЖЕТУ</p>
      <h1>Стоимость разработки<br /><span class="gradient-text">под задачу проекта</span></h1>
      <p class="prices__lead">Здесь будут минимальные бюджеты по основным направлениям. Итоговая стоимость зависит от объёма, сценариев и интеграций — после короткого обсуждения можно точно определить формат работ.</p>
      <div class="prices__grid">
        {directions.map(([title, description]) => <article><h2>{title}</h2><p>{description}</p><span>Ориентир «от» будет добавлен после утверждения</span></article>)}
      </div>
      <a class="prices__cta" href="/#contact">Обсудить задачу <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
<style>
  .prices { min-height:100svh; padding:calc(var(--header-height) + 86px) 0 120px; background:radial-gradient(circle at 82% 20%,rgba(46,107,255,.16),transparent 29%),radial-gradient(circle at 16% 78%,rgba(255,51,77,.12),transparent 31%); }
  .prices__inner { max-width:1100px; }.prices h1 { max-width:820px; margin-bottom:26px; font-size:clamp(48px,6vw,82px); line-height:.99; letter-spacing:-.055em; }.prices__lead { max-width:670px; color:var(--text-secondary); font-size:clamp(17px,1.5vw,20px); }.prices__grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; margin-top:55px; }.prices article { min-width:0; padding:28px; border:1px solid rgba(122,157,205,.2); border-radius:var(--radius-md); background:rgba(9,19,33,.72); }.prices h2 { margin-bottom:11px; font-size:26px; }.prices article p { min-height:52px; margin-bottom:22px; color:var(--text-secondary); }.prices article span { color:var(--blue-bright); font-size:13px; font-weight:700; }.prices__cta { display:inline-flex; align-items:center; gap:12px; min-height:52px; margin-top:35px; padding:0 20px; border:1px solid rgba(40,199,255,.52); border-radius:14px; background:#0d192a; box-shadow:0 0 20px rgba(46,107,255,.16); font-weight:800; }.prices__cta:hover { border-color:var(--blue-bright); background:rgba(46,107,255,.13); }
  @media(max-width:767px) { .prices { padding:calc(var(--header-height) + 54px) 0 72px; }.prices h1 { font-size:clamp(40px,12vw,54px); }.prices__lead { font-size:16px; }.prices__grid { grid-template-columns:1fr; gap:12px; margin-top:36px; }.prices article { padding:22px; }.prices article p { min-height:0; }.prices__cta { width:100%; justify-content:center; } }
</style>
